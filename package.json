{
  "name": "thetabench",
  "version": "0.1.0",
  "private": true,
  "description": "ThetaBench — A scalable platform for training and evaluating autonomous web agents",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter shopify-admin-sim dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test:run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci:check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "ci:fix": "pnpm format && pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.1",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,css,yml,yaml}": "prettier --write"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "msw",
      "sharp",
      "unrs-resolver"
    ]
  }
}
