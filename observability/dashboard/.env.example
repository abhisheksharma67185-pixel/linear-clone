# Theta Observability Dashboard env
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXTAUTH_URL=http://localhost:3100
NEXTAUTH_SECRET=change-me-32-bytes-base64

# Postgres (shared with Go API control plane)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/theta_observability

# OAuth providers
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend email provider
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=noreply@theta.dev
