{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theta.observability/schema/trace.schema.json",
  "title": "Theta Observability Trace",
  "description": "A single multimodal agent trace: a tree of steps (llm, tool, retrieval, robotics, human, annotation, custom) containing messages, tool calls, sensor frames, token usage and annotations. OTel-GenAI-aligned.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "project_id",
    "name",
    "started_at",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Trace payload schema version."
    },
    "trace_id": {
      "type": "string",
      "pattern": "^tr_[A-Za-z0-9]{6,}$",
      "description": "Unique trace identifier. ULID-style with `tr_` prefix."
    },
    "project_id": {
      "type": "string",
      "pattern": "^proj_[A-Za-z0-9]{4,}$"
    },
    "org_id": {
      "type": "string",
      "pattern": "^org_[A-Za-z0-9]{4,}$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "run_id": { "type": "string", "maxLength": 128 },
    "run_type": {
      "type": "string",
      "enum": ["prod", "eval", "dev", "test", "replay", "backfill", "other"]
    },
    "use_case": { "type": "string", "maxLength": 128 },
    "user_id": { "type": "string", "maxLength": 256 },
    "group": { "type": "string", "maxLength": 128 },
    "platform": {
      "type": "string",
      "enum": ["web", "mobile", "desktop", "server", "robot", "sim", "cli", "other"]
    },
    "model": { "type": "string", "maxLength": 256 },
    "status": {
      "type": "string",
      "enum": ["success", "error", "running", "cancelled"]
    },
    "error_message": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string", "maxLength": 64 },
      "maxItems": 64
    },
    "metadata": {
      "type": "object",
      "description": "Free-form JSON metadata. Indexed as JSON in BigQuery.",
      "additionalProperties": true
    },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at":   { "type": "string", "format": "date-time" },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "token_usage": { "$ref": "#/$defs/token_usage" },
    "cost_usd": { "type": "number", "minimum": 0 },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/$defs/step" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/observed_event" },
      "description": "Optional generic event timeline preserved alongside normalized step semantics."
    },
    "attachments": {
      "type": "array",
      "items": { "$ref": "#/$defs/content_part" }
    },
    "annotations": {
      "type": "array",
      "items": { "$ref": "#/$defs/annotation" }
    }
  },

  "$defs": {
    "token_usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input":  { "type": "integer", "minimum": 0 },
        "output": { "type": "integer", "minimum": 0 },
        "total":  { "type": "integer", "minimum": 0 },
        "cached_input":    { "type": "integer", "minimum": 0 },
        "reasoning":       { "type": "integer", "minimum": 0 }
      }
    },

    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "type"],
      "properties": {
        "step_id": {
          "type": "string",
          "pattern": "^st_[A-Za-z0-9]{3,}$"
        },
        "parent_step_id": {
          "type": ["string", "null"],
          "pattern": "^st_[A-Za-z0-9]{3,}$"
        },
        "index": { "type": "integer", "minimum": 0 },
        "type": {
          "type": "string",
          "enum": ["llm", "tool", "retrieval", "robotics", "human", "annotation", "custom"]
        },
        "name": { "type": "string", "maxLength": 256 },
        "model": { "type": "string", "maxLength": 256 },
        "status": {
          "type": "string",
          "enum": ["success", "error", "running", "cancelled"]
        },
        "error_message": { "type": "string" },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at":   { "type": "string", "format": "date-time" },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "token_usage": { "$ref": "#/$defs/token_usage" },
        "cost_usd": { "type": "number", "minimum": 0 },
        "messages": {
          "type": "array",
          "items": { "$ref": "#/$defs/message" }
        },
        "attachments": {
          "type": "array",
          "items": { "$ref": "#/$defs/content_part" }
        },
        "tool_calls": {
          "type": "array",
          "items": { "$ref": "#/$defs/tool_call" }
        },
        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/observed_event" }
        },
        "sensor_frames": {
          "type": "array",
          "items": { "$ref": "#/$defs/sensor_frame" }
        },
        "retrieval": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "query": { "type": "string" },
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "id": { "type": "string" },
                  "score": { "type": "number" },
                  "text": { "type": "string" },
                  "uri":  { "type": "string" }
                }
              }
            }
          }
        },
        "metadata": { "type": "object", "additionalProperties": true },
        "annotations": {
          "type": "array",
          "items": { "$ref": "#/$defs/annotation" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "robotics" } }, "required": ["type"] },
          "then": {
            "anyOf": [
              { "required": ["sensor_frames"] },
              { "required": ["messages"] }
            ]
          }
        }
      ]
    },

    "observed_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "event_id": { "type": "string" },
        "parent_event_id": { "type": "string" },
        "step_id": { "type": "string" },
        "parent_step_id": { "type": "string" },
        "index": { "type": "integer", "minimum": 0 },
        "type": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "model": { "type": "string" },
        "message": { "$ref": "#/$defs/message" },
        "tool_call": { "$ref": "#/$defs/tool_call" },
        "attachment": { "$ref": "#/$defs/content_part" },
        "sensor_frame": { "$ref": "#/$defs/sensor_frame" },
        "value": {},
        "metadata": { "type": "object", "additionalProperties": true }
      }
    },

    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["system", "user", "assistant", "tool", "developer", "function"]
        },
        "name": { "type": "string", "maxLength": 256 },
        "content": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/content_part" }
            }
          ]
        },
        "tool_call_id": { "type": "string" },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    },

    "content_part": {
      "oneOf": [
        { "$ref": "#/$defs/part_text" },
        { "$ref": "#/$defs/part_image" },
        { "$ref": "#/$defs/part_audio" },
        { "$ref": "#/$defs/part_video" },
        { "$ref": "#/$defs/part_sensor" },
        { "$ref": "#/$defs/part_file" }
      ]
    },

    "part_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string" }
      }
    },
    "part_image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "image" },
        "uri":  { "type": "string", "description": "gs:// or https:// URI" },
        "data_base64": { "type": "string", "contentEncoding": "base64" },
        "mime": { "type": "string", "default": "image/png" },
        "width":  { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "alt": { "type": "string" }
      },
      "anyOf": [{ "required": ["uri"] }, { "required": ["data_base64"] }]
    },
    "part_audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "audio" },
        "uri":  { "type": "string" },
        "data_base64": { "type": "string" },
        "mime": { "type": "string", "default": "audio/mpeg" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "sample_rate_hz": { "type": "integer", "minimum": 1 },
        "transcript": { "type": "string" }
      },
      "anyOf": [{ "required": ["uri"] }, { "required": ["data_base64"] }]
    },
    "part_video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "uri"],
      "properties": {
        "type": { "const": "video" },
        "uri":  { "type": "string" },
        "mime": { "type": "string", "default": "video/mp4" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "width":  { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps":    { "type": "number",  "minimum": 0 },
        "poster_uri": { "type": "string" }
      }
    },
    "part_sensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "modality", "uri"],
      "properties": {
        "type": { "const": "sensor" },
        "modality": {
          "type": "string",
          "enum": [
            "joint_state", "pose", "imu", "lidar", "depth",
            "force_torque", "gripper", "camera", "tactile", "custom"
          ]
        },
        "uri":  { "type": "string" },
        "mime": { "type": "string" },
        "rate_hz": { "type": "number", "minimum": 0 },
        "shape": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "units": { "type": "string" }
      }
    },
    "part_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "uri"],
      "properties": {
        "type": { "const": "file" },
        "uri":  { "type": "string" },
        "mime": { "type": "string", "default": "application/octet-stream" },
        "name": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    },

    "tool_call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id":   { "type": "string" },
        "name": { "type": "string", "maxLength": 256 },
        "arguments": {
          "description": "Tool arguments. Object when structured; string for raw JSON as emitted by some providers.",
          "oneOf": [
            { "type": "object", "additionalProperties": true },
            { "type": "string" }
          ]
        },
        "result": {
          "description": "Tool result value. Free-form.",
          "oneOf": [
            { "type": "object", "additionalProperties": true },
            { "type": "array" },
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        "error": { "type": "string" },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at":   { "type": "string", "format": "date-time" },
        "latency_ms": { "type": "integer", "minimum": 0 }
      }
    },

    "sensor_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modality", "uri"],
      "properties": {
        "modality": {
          "type": "string",
          "enum": [
            "joint_state", "pose", "imu", "lidar", "depth",
            "force_torque", "gripper", "camera", "tactile", "custom"
          ]
        },
        "uri":   { "type": "string" },
        "mime":  { "type": "string" },
        "fps":   { "type": "number", "minimum": 0 },
        "rate_hz": { "type": "number", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "shape": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "units": { "type": "string" },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at":   { "type": "string", "format": "date-time" },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    },

    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["comment", "label", "score", "rating", "correction"]
        },
        "author_id":    { "type": "string" },
        "author_email": { "type": "string", "format": "email" },
        "target": {
          "type": "string",
          "enum": ["trace", "step", "message", "tool_call", "attachment"],
          "default": "trace"
        },
        "target_id": { "type": "string" },
        "text":   { "type": "string" },
        "label":  { "type": "string" },
        "score":  { "type": "number" },
        "rating": { "type": "string", "enum": ["up", "down", "neutral"] },
        "created_at": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
