# Theta Observability — environment template.
# Copy to `.env` and fill in real secrets. Never commit `.env`.
#
# The docker-compose.dev.yml file hard-codes safe dev defaults for most of
# these — this file documents production-style env vars and is also the
# source of truth for the SDKs, the Go API, and the Next.js dashboard.

# ----------------------------------------------------------------------------
# Postgres (control plane)
# ----------------------------------------------------------------------------
DB_URL=postgres://theta:theta@localhost:5432/theta_obs?sslmode=disable

# ----------------------------------------------------------------------------
# Object storage (GCS / fake-gcs-server)
# ----------------------------------------------------------------------------
# Local dev: point at fake-gcs-server. Prod: leave GCS_ENDPOINT unset so the
# google-cloud-storage client uses Google's real endpoint.
GCS_ENDPOINT=http://localhost:4443/storage/v1/
GCS_PUBLIC_HOST=http://localhost:4443
GCS_BUCKET=theta-obs-dev
# Consumed by the official google-cloud-storage Go/Python clients.
STORAGE_EMULATOR_HOST=localhost:4443
# Path to a service-account JSON for signed URLs in production.
GOOGLE_APPLICATION_CREDENTIALS=

# ----------------------------------------------------------------------------
# BigQuery (trace index)
# ----------------------------------------------------------------------------
BQ_PROJECT=theta-obs-dev
BQ_DATASET=theta_observability
# Local dev: point at goccy/bigquery-emulator. Unset in production.
BIGQUERY_EMULATOR_HOST=localhost:9050

# ----------------------------------------------------------------------------
# Auth
# ----------------------------------------------------------------------------
# Shared between the Go API (verifies) and the dashboard (mints) for
# per-request dashboard JWTs. In prod, prefer JWKS over a shared secret.
JWT_SECRET=replace-me-with-a-long-random-string
JWT_JWKS_URL=
# NextAuth v5
NEXTAUTH_URL=http://localhost:3100
NEXTAUTH_SECRET=replace-me-with-another-long-random-string

# ----------------------------------------------------------------------------
# OAuth providers (NextAuth v5)
# ----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# Transactional email (Resend)
# ----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@theta.observability

# ----------------------------------------------------------------------------
# Billing (Stripe)  — stubbed in MVP, wired in MVP+1.
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TRACES_INGESTED=
STRIPE_PRICE_MEDIA_STORAGE_GB=

# ----------------------------------------------------------------------------
# Dashboard (Next.js)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
API_URL_INTERNAL=http://localhost:8080

# ----------------------------------------------------------------------------
# API server
# ----------------------------------------------------------------------------
PORT=8080
ENV=dev
LOG_LEVEL=info
