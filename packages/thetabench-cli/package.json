{
  "name": "@thetabench/cli",
  "version": "0.1.0",
  "description": "Command-line interface for the ThetaBench simulation engine",
  "type": "module",
  "bin": {
    "theta": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@thetabench/core": "workspace:*",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "ora": "^8.1.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsdown": "^0.21.10",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "thetabench",
    "cli",
    "agent",
    "benchmark",
    "simulation",
    "rl"
  ],
  "license": "MIT"
}
